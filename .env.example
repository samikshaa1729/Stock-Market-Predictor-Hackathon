# Never commit real passwords to GitHub. On Render, enter these under Environment.
SECRET_KEY=put-a-long-random-string-here
FLASK_ENV=production

# From Aiven Console -> your MySQL service -> Overview -> Connection information
DB_HOST=xxxxx-yourproject.a.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=your-aiven-password
DB_NAME=defaultdb
DB_SSL=true

# Optional: lighter Random Forest for small servers (default 150)
RF_TREES=80
